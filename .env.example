# Supabase (Project settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Console → API keys
ANTHROPIC_API_KEY=

# Any long random string; Vercel Cron sends it automatically when set in Vercel
CRON_SECRET=

# Optional tuning
KUREAN_DAILY_LIMIT=8
KUREAN_MIN_SCORE=7
KUREAN_SCORE_MODEL=claude-haiku-5-5
KUREAN_WRITE_MODEL=claude-sonnet-5-5
